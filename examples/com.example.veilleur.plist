<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd job: run veilleur daily at 07:00.
     Replace YOUR_USER with your username (launchd needs absolute paths).
     Copy to ~/Library/LaunchAgents/ then: launchctl load <this file>. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.veilleur</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USER/.local/bin/veilleur-cron</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/.local/state/veilleur/veilleur.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/.local/state/veilleur/veilleur.err.log</string>
</dict>
</plist>
